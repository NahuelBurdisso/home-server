# Ping URLs for setup/heartbeat.sh and setup/backup.sh. Copy to ~/server/secrets/healthchecks.env,
# fill in, chmod 600. One check per line at healthchecks.io (Add Check, then copy its ping URL).
# Leave one empty and that script just doesn't ping.

# Period 5 minutes, grace 15 minutes.
HC_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# Period 1 day, grace 2 hours.
HC_BACKUP_URL=https://hc-ping.com/<uuid>
