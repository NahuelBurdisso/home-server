<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.server.backup</string>
  <key>ProgramArguments</key>
  <array><string>/Users/server/server/setup/backup.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/server/Library/Logs/backup.log</string>
  <key>StandardErrorPath</key><string>/Users/server/Library/Logs/backup.log</string>
</dict>
</plist>
