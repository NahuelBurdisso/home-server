# Offsite copy for backup.sh. Copy to ~/server/secrets/restic-offsite.env, fill in, chmod 600.
# Any restic backend works; two cheap options for a few hundred GB of photos:

# Backblaze B2 (S3 API)
export RESTIC_REPOSITORY="s3:https://s3.us-west-004.backblazeb2.com/<bucket>/mac-server"
export AWS_ACCESS_KEY_ID="<keyID>"
export AWS_SECRET_ACCESS_KEY="<applicationKey>"

# Hetzner Storage Box (SFTP; add the Mac's SSH key to the box first)
# export RESTIC_REPOSITORY="sftp://u123456@u123456.your-storagebox.de:23/mac-server"

# Its own password, different from the local repository. Keep a copy outside the Mac:
# without it, the offsite copy can't be read.
export RESTIC_PASSWORD="<long random password>"
