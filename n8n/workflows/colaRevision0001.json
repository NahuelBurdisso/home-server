      "name": "¿Se acumularon?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// From 20 pending on; again only when 10 more pile up or a week went by.\nconst MINIMO = 20;\nconst st = $input.first().json;\nconst n = st.para_revisar ?? 0;\nconst s = $getWorkflowStaticData('global');\nif (n < MINIMO) { delete s.ultimo; return []; }\nif (s.ultimo && n < s.ultimo.n + 10 && Date.now() - s.ultimo.at < 7 * 864e5) return [];\ns.ultimo = { n, at: Date.now() };\nreturn [{ json: {\n  title: 'Gastos para revisar',\n  message: `Tenés ${n} gastos esperando categoría. Revisarlos te lleva unos minutos y los gráficos quedan bien.`,\n  tag: 'receipt', click: st.url + '/revisar',\n} }];\n"
      }
    },
    {
      "id": "b4aedb2f-10b4-5d0e-a3c4-2785e59d9b46",
      "name": "Avisar por ntfy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8091",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ topic: $env.NTFY_TOPIC, title: $json.title, message: $json.message, tags: [$json.tag || 'robot'], click: $json.click, priority: $json.priority || 3 }) }}",
        "options": {
          "timeout": 20000
        }
      }
    }
  ],
